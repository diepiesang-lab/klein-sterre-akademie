# Supabase server-side connection
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET

# Supabase browser sign-in (publishable key is safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Admin access PIN - change this before going live
ADMIN_PIN=CHANGE_ME

# Resend booking confirmation email delivery
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
BOOKING_FROM_EMAIL=Klein Sterre Akademie <bookings@your-verified-domain.co.za>
